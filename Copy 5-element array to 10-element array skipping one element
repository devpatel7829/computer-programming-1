#include <stdio.h>

int main() {
    int a[5], b[10] = {0};

    printf("Enter 5 elements: ");
    for (int i = 0; i < 5; i++) {
        scanf("%d", &a[i]);
    }

    for (int i = 0; i < 5; i++) {
        b[i * 2] = a[i];
    }

    printf("Result array: ");
    for (int i = 0; i < 10; i++) {
        printf("%d ", b[i]);
    }
    printf("\n");

    return 0;
}